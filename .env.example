# OpenAI (for reasoning)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Azure Vision
AZURE_VISION_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
AZURE_VISION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS Rekognition (auth must be configured via env or profile; region is required here)
AWS_REGION=us-east-1

# Google Vision
# Service Account JSON path. Make sure billing is enabled on the project.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa.json

# App
PORT=8000
